rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(householdId) {
      return isSignedIn() && request.auth.uid == householdId;
    }

    function isMember(householdId) {
      return isSignedIn() && (
        isOwner(householdId) ||
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /invites/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow create: if isMember(request.resource.data.householdId);
      allow delete: if isSignedIn() && request.auth.token.email == email;
    }

    match /households/{householdId} {
      allow create: if isSignedIn() && householdId == request.auth.uid;
      allow read, update: if isMember(householdId);

      match /members/{memberId} {
        allow read: if isMember(householdId);
        allow create: if isSignedIn() && request.auth.uid == memberId && (
          isOwner(householdId) ||
          (request.auth.token.email != null &&
            get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.householdId == householdId)
        );
      }

      match /settings/{docId} {
        allow read, write: if isMember(householdId);
      }

      match /plan/{docId} {
        allow read, write: if isMember(householdId);
      }

      match /recipes/{recipeId} {
        allow read, write: if isMember(householdId);
      }

      match /shoppingItems/{itemId} {
        allow read, write: if isMember(householdId);
      }

      match /templates/{templateId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
